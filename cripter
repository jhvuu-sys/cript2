--- Ball landing predictor: tracks every ball, marker + arc per ball, color panel, switches

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer

-- Settings
local BALL_NAME = "Ball"          -- every Part or Model with this name gets tracked
local MAX_BALLS = 10              -- safety cap on how many balls are tracked at once
local STEP = 1 / 30               -- simulation step (seconds)
local MAX_TIME = 6                -- how far ahead to predict (seconds)

local IGNORE_INVISIBLE = true     -- skip parts that are (nearly) transparent
local INVISIBLE_THRESHOLD = 0.95  -- Transparency at or above this counts as invisible

local ARC_STRIDE = 2              -- draw one segment per this many steps (higher = fewer parts)
local ARC_THICKNESS = 0.25
local ARC_TRANSPARENCY = 0.35
local ARC_DASHED = true           -- true = dashed line, false = solid

local enabled = true
local arcEnabled = true
local markerColor = Color3.fromRGB(255, 70, 70)

local PRESETS = {
    Color3.fromRGB(255, 70, 70),   -- red
    Color3.fromRGB(255, 160, 40),  -- orange
    Color3.fromRGB(250, 220, 60),  -- yellow
    Color3.fromRGB(60, 220, 100),  -- green
    Color3.fromRGB(70, 160, 255),  -- blue
    Color3.fromRGB(190, 100, 255), -- purple
}

---------------------------------------------------------------------
-- Shared folders (one place for the raycast to ignore all visuals)
---------------------------------------------------------------------
local markerFolder = Instance.new("Folder")
markerFolder.Name = "LandingMarkers"
markerFolder.Parent = Workspace

local arcFolder = Instance.new("Folder")
arcFolder.Name = "TrajectoryArcs"
arcFolder.Parent = Workspace

local highlightFolder = Instance.new("Folder")
highlightFolder.Name = "BallHighlights"
highlightFolder.Parent = Workspace

---------------------------------------------------------------------
-- Per-ball tracking
---------------------------------------------------------------------
local balls = {}      -- [instance] = data table for that ball
local ballCount = 0

local function createMarker()
    local marker = Instance.new("Part")
    marker.Name = "LandingMarker"
    marker.Shape = Enum.PartType.Cylinder
    marker.Size = Vector3.new(0.15, 5, 5)
    marker.Anchored = true
    marker.CanCollide = false
    marker.CanQuery = false
    marker.CanTouch = false
    marker.Material = Enum.Material.Neon
    marker.Color = markerColor
    marker.Transparency = 1
    marker.Parent = markerFolder
    return marker
end

local function createHighlight()
    local highlight = Instance.new("Highlight")
    highlight.FillColor = markerColor
    highlight.FillTransparency = 0.6
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.Parent = highlightFolder
    return highlight
end

local function addBall(inst)
    if balls[inst] then return end
    if inst.Name ~= BALL_NAME then return end
    if not (inst:IsA("BasePart") or inst:IsA("Model")) then return end
    if ballCount >= MAX_BALLS then return end

    local folder = Instance.new("Folder")
    folder.Name = "Arc"
    folder.Parent = arcFolder

    balls[inst] = {
        inst = inst,
        part = nil,
        lastPos = nil,
        estVel = Vector3.zero,
        marker = createMarker(),
        highlight = createHighlight(),
        folder = folder,
        segments = {},  -- pooled arc parts for this ball
    }
    ballCount += 1
end

local function removeBall(inst)
    local data = balls[inst]
    if not data then return end
    data.marker:Destroy()
    data.highlight:Destroy()
    data.folder:Destroy()
    balls[inst] = nil
    ballCount -= 1
end

-- Resolves the BasePart to read position/velocity from (handles Models)
local function getPart(data)
    local part = data.part
    if part and part.Parent then return part end

    local inst = data.inst
    if inst:IsA("BasePart") then
        part = inst
    else
        part = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
    end
    data.part = part
    return part
end

-- Pick up balls that already exist, then watch for new/removed ones
for _, d in ipairs(Workspace:GetDescendants()) do
    addBall(d)
end
Workspace.DescendantAdded:Connect(addBall)
Workspace.DescendantRemoving:Connect(removeBall)

---------------------------------------------------------------------
-- Arc drawing (per ball)
---------------------------------------------------------------------
local function getSegment(data, index)
    local seg = data.segments[index]
    if not seg then
        seg = Instance.new("Part")
        seg.Anchored = true
        seg.CanCollide = false
        seg.CanQuery = false
        seg.CanTouch = false
        seg.CastShadow = false
        seg.Material = Enum.Material.Neon
        seg.Transparency = 1
        seg.Parent = data.folder
        data.segments[index] = seg
    end
    return seg
end

local function hideArc(data)
    for _, seg in ipairs(data.segments) do
        seg.Transparency = 1
    end
end

local function drawArc(data, points)
    local used = 0
    local i = 1
    while i < #points do
        local j = math.min(i + ARC_STRIDE, #points)
        used += 1

        local a, b = points[i], points[j]
        local length = (b - a).Magnitude
        local seg = getSegment(data, used)

        if length > 0.01 and not (ARC_DASHED and used % 2 == 0) then
            seg.Size = Vector3.new(ARC_THICKNESS, ARC_THICKNESS, length)
            seg.CFrame = CFrame.lookAt((a + b) / 2, b)
            seg.Color = markerColor
            seg.Transparency = ARC_TRANSPARENCY
        else
            seg.Transparency = 1
        end

        i = j
    end

    for k = used + 1, #data.segments do
        data.segments[k].Transparency = 1
    end
end

local function hideBall(data)
    data.marker.Transparency = 1
    data.highlight.Adornee = nil
    hideArc(data)
end

local function hideAll()
    for _, data in pairs(balls) do
        hideBall(data)
    end
end

local function setMarkerColor(color)
    markerColor = color
    for _, data in pairs(balls) do
        data.marker.Color = color
        data.highlight.FillColor = color
    end
    -- arc segments pick up the new color on the next draw
end

---------------------------------------------------------------------
-- Prediction
---------------------------------------------------------------------
local skipped = setmetatable({}, { __mode = "k" })  -- invisible parts we've learned to ignore
local params                                         -- shared by all balls, rebuilt each frame

local function buildParams()
    local ignore = { markerFolder, arcFolder, highlightFolder }
    for inst in pairs(balls) do
        table.insert(ignore, inst)  -- every tracked ball ignores every other ball
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then table.insert(ignore, plr.Character) end
    end
    for part in pairs(skipped) do
        table.insert(ignore, part)
    end

    local p = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Exclude
    p.FilterDescendantsInstances = ignore
    p.RespectCanCollide = true  -- ignores parts with CanCollide = false
    return p
end

-- Casts one segment, skipping invisible parts and re-casting past them
local function castSegment(from, to)
    for _ = 1, 6 do
        local hit = Workspace:Raycast(from, to - from, params)
        if not hit then return nil end

        local part = hit.Instance
        if IGNORE_INVISIBLE and part.Transparency >= INVISIBLE_THRESHOLD then
            skipped[part] = true
            params = buildParams()
        else
            return hit
        end
    end
    return nil
end

-- Returns the landing position (or nil) and every point along the path
local function predictLanding(pos, vel)
    local gravity = Vector3.new(0, -Workspace.Gravity, 0)

    local points = { pos }
    local t = 0
    while t < MAX_TIME do
        local newPos = pos + vel * STEP + 0.5 * gravity * STEP * STEP
        local hit = castSegment(pos, newPos)
        if hit then
            table.insert(points, hit.Position)
            return hit.Position, points
        end
        table.insert(points, newPos)
        vel = vel + gravity * STEP
        pos = newPos
        t += STEP
    end
    return nil, points
end

RunService.Heartbeat:Connect(function(dt)
    if not enabled then
        hideAll()
        for _, data in pairs(balls) do
            data.lastPos = nil
        end
        return
    end

    params = buildParams()  -- once per frame, shared by every ball

    for inst, data in pairs(balls) do
        local part = getPart(data)

        if not part then
            data.lastPos = nil
            hideBall(data)
        else
            if data.lastPos and dt > 0 then
                data.estVel = data.estVel:Lerp((part.Position - data.lastPos) / dt, 0.5)
            end
            data.lastPos = part.Position

            local vel = part.AssemblyLinearVelocity
            if vel.Magnitude <= 0.1 then vel = data.estVel end

            data.highlight.Adornee = inst

            local landing, points = predictLanding(part.Position, vel)

            if landing then
                data.marker.Transparency = 0.35
                data.marker.CFrame = CFrame.new(landing + Vector3.new(0, 0.1, 0))
                    * CFrame.Angles(0, 0, math.rad(90))
            else
                data.marker.Transparency = 1
            end

            if arcEnabled then
                drawArc(data, points)
            else
                hideArc(data)
            end
        end
    end
end)

---------------------------------------------------------------------
-- Settings panel
---------------------------------------------------------------------
local function styleToggle(btn, on)
    btn.Text = on and "ON" or "OFF"
    btn.BackgroundColor3 = on
        and Color3.fromRGB(35, 165, 89)
        or Color3.fromRGB(190, 60, 60)
end

local function createPanel()
    local gui = Instance.new("ScreenGui")
    gui.Name = "MarkerColorPanel"
    gui.ResetOnSpawn = false
    gui.Parent = player:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 230, 0, 184)
    frame.Position = UDim2.new(0, 20, 0.5, -92)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 34)
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true  -- deprecated but still works; drag the panel anywhere
    frame.Parent = gui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -90, 0, 24)
    title.Position = UDim2.new(0, 10, 0, 8)
    title.BackgroundTransparency = 1
    title.Text = "Landing Marker"
    title.TextColor3 = Color3.new(1, 1, 1)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 14
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = frame

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0, 60, 0, 24)
    toggleBtn.Position = UDim2.new(1, -70, 0, 8)
    toggleBtn.Font = Enum.Font.GothamBold
    toggleBtn.TextSize = 12
    toggleBtn.TextColor3 = Color3.new(1, 1, 1)
    toggleBtn.Parent = frame
    Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 5)
    styleToggle(toggleBtn, enabled)

    toggleBtn.Activated:Connect(function()
        enabled = not enabled
        styleToggle(toggleBtn, enabled)
        if not enabled then hideAll() end
    end)

    for i, color in ipairs(PRESETS) do
        local swatch = Instance.new("TextButton")
        swatch.Size = UDim2.new(0, 28, 0, 28)
        swatch.Position = UDim2.new(0, 10 + (i - 1) * 35, 0, 48)
        swatch.BackgroundColor3 = color
        swatch.Text = ""
        swatch.Parent = frame
        Instance.new("UICorner", swatch).CornerRadius = UDim.new(0, 6)

        swatch.Activated:Connect(function()
            setMarkerColor(color)
        end)
    end

    local hexLabel = Instance.new("TextLabel")
    hexLabel.Size = UDim2.new(0, 50, 0, 26)
    hexLabel.Position = UDim2.new(0, 10, 0, 90)
    hexLabel.BackgroundTransparency = 1
    hexLabel.Text = "Hex #"
    hexLabel.TextColor3 = Color3.new(1, 1, 1)
    hexLabel.Font = Enum.Font.GothamMedium
    hexLabel.TextSize = 13
    hexLabel.TextXAlignment = Enum.TextXAlignment.Left
    hexLabel.Parent = frame

    local hexBox = Instance.new("TextBox")
    hexBox.Size = UDim2.new(1, -80, 0, 26)
    hexBox.Position = UDim2.new(0, 60, 0, 90)
    hexBox.BackgroundColor3 = Color3.fromRGB(50, 50, 58)
    hexBox.BorderSizePixel = 0
    hexBox.PlaceholderText = "FF4646"
    hexBox.Text = ""
    hexBox.TextColor3 = Color3.new(1, 1, 1)
    hexBox.Font = Enum.Font.Gotham
    hexBox.TextSize = 13
    hexBox.ClearTextOnFocus = false
    hexBox.Parent = frame
    Instance.new("UICorner", hexBox).CornerRadius = UDim.new(0, 5)

    hexBox.FocusLost:Connect(function()
        local hex = hexBox.Text:gsub("#", ""):gsub("%s", "")
        if #hex == 6 and hex:match("^%x+$") then
            setMarkerColor(Color3.fromRGB(
                tonumber(hex:sub(1, 2), 16),
                tonumber(hex:sub(3, 4), 16),
                tonumber(hex:sub(5, 6), 16)
            ))
        else
            hexBox.Text = ""  -- invalid input, keep the current color
        end
    end)

    local arcLabel = Instance.new("TextLabel")
    arcLabel.Size = UDim2.new(1, -90, 0, 24)
    arcLabel.Position = UDim2.new(0, 10, 0, 134)
    arcLabel.BackgroundTransparency = 1
    arcLabel.Text = "Trajectory Arc"
    arcLabel.TextColor3 = Color3.new(1, 1, 1)
    arcLabel.Font = Enum.Font.GothamMedium
    arcLabel.TextSize = 13
    arcLabel.TextXAlignment = Enum.TextXAlignment.Left
    arcLabel.Parent = frame

    local arcBtn = Instance.new("TextButton")
    arcBtn.Size = UDim2.new(0, 60, 0, 24)
    arcBtn.Position = UDim2.new(1, -70, 0, 134)
    arcBtn.Font = Enum.Font.GothamBold
    arcBtn.TextSize = 12
    arcBtn.TextColor3 = Color3.new(1, 1, 1)
    arcBtn.Parent = frame
    Instance.new("UICorner", arcBtn).CornerRadius = UDim.new(0, 5)
    styleToggle(arcBtn, arcEnabled)

    arcBtn.Activated:Connect(function()
        arcEnabled = not arcEnabled
        styleToggle(arcBtn, arcEnabled)
        if not arcEnabled then
            for _, data in pairs(balls) do hideArc(data) end
        end
    end)
end

createPanel()
